<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rahimi Solution | Premium Healthcare & Business IT Solutions</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-gold: #D4AF37;
            --primary-dark: #0A0A0F;
            --primary-navy: #1A1A2E;
            --secondary-burgundy: #8B1E3F;
            --accent-teal: #2EC4B6;
            --light-cream: #F5F2E8;
            --medium-gold: #B8860B;
            --dark-gold: #8B7355;
            --gradient-luxury: linear-gradient(135deg, var(--primary-gold) 0%, var(--medium-gold) 50%, var(--dark-gold) 100%);
            --gradient-dark: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-navy) 100%);
            --gradient-premium: linear-gradient(135deg, var(--primary-gold) 0%, var(--secondary-burgundy) 100%);
            --shadow-soft: 0 10px 30px rgba(212, 175, 55, 0.1);
            --shadow-hard: 0 25px 50px rgba(212, 175, 55, 0.2);
            --shadow-luxury: 0 20px 40px rgba(139, 30, 63, 0.15);
            --radius-elegant: 16px;
            --radius-pill: 50px;
            --transition-luxury: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            overflow-x: hidden;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--primary-dark);
            color: var(--light-cream);
            line-height: 1.7;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, .logo {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Luxury Header - FIXED FOR DESKTOP */
        .luxury-header {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(10, 10, 15, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(212, 175, 55, 0.2);
            transition: var(--transition-luxury);
        }

        .luxury-header.scrolled {
            padding: 10px 0;
            box-shadow: var(--shadow-hard);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 0;
        }

        .logo {
            display: flex;
            align-items: center;
            text-decoration: none;
        }

        .logo-icon {
            width: 60px;
            height: 60px;
            background: var(--gradient-luxury);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            color: var(--primary-dark);
            font-size: 28px;
            font-weight: 900;
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }

        .logo-text {
            font-size: 32px;
            font-weight: 800;
            background: var(--gradient-luxury);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 2px 10px rgba(212, 175, 55, 0.2);
        }

        .logo-subtitle {
            font-size: 12px;
            color: var(--light-cream);
            display: block;
            font-weight: 400;
            opacity: 0.8;
            letter-spacing: 1px;
            margin-top: 2px;
        }

        /* DESKTOP NAVIGATION - Always visible on desktop */
        .desktop-nav {
            display: flex;
            align-items: center;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 40px;
            margin-right: 30px;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--light-cream);
            font-weight: 500;
            font-size: 16px;
            padding: 8px 0;
            position: relative;
            transition: var(--transition-luxury);
            letter-spacing: 0.5px;
        }

        .nav-links a:hover {
            color: var(--primary-gold);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--gradient-luxury);
            transition: width 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .luxury-cta {
            background: var(--gradient-luxury);
            color: var(--primary-dark);
            padding: 14px 35px;
            border-radius: var(--radius-pill);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition-luxury);
            box-shadow: var(--shadow-soft);
            letter-spacing: 0.5px;
            border: none;
            cursor: pointer;
        }

        .luxury-cta:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-hard);
        }

        /* MOBILE TOGGLE - Only visible on mobile */
        .mobile-toggle {
            display: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--primary-gold);
            background: none;
            border: none;
            z-index: 1001;
        }

        /* MOBILE MENU - Hidden on desktop, visible on mobile when active */
        .mobile-menu {
            display: none; /* Hidden by default on all screens */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: rgba(10, 10, 15, 0.98);
            padding: 100px 30px 30px;
            transform: translateX(-100%);
            opacity: 0;
            transition: var(--transition-luxury);
            z-index: 999;
            backdrop-filter: blur(20px);
            overflow-y: auto;
        }

        .mobile-menu.active {
            transform: translateX(0);
            opacity: 1;
        }

        .mobile-nav-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .mobile-nav-links a {
            display: block;
            padding: 18px 0;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
            text-decoration: none;
            color: var(--light-cream);
            font-weight: 600;
            font-size: 18px;
            transition: var(--transition-luxury);
        }

        .mobile-nav-links a:hover {
            color: var(--primary-gold);
            padding-left: 15px;
        }

        .mobile-menu .luxury-cta {
            margin-top: 40px;
            display: block;
            text-align: center;
            width: 100%;
        }

        /* Luxury Hero Section */
        .hero-luxury {
            padding: 200px 0 150px;
            background: var(--gradient-dark);
            position: relative;
            overflow: hidden;
        }

        .hero-luxury::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 20% 30%, rgba(212, 175, 55, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(139, 30, 63, 0.1) 0%, transparent 50%);
        }

        .hero-content {
            max-width: 800px;
            position: relative;
            z-index: 10;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(212, 175, 55, 0.1);
            color: var(--primary-gold);
            padding: 12px 25px;
            border-radius: var(--radius-pill);
            font-weight: 600;
            margin-bottom: 30px;
            border: 1px solid rgba(212, 175, 55, 0.3);
            backdrop-filter: blur(10px);
            letter-spacing: 1.5px;
            font-size: 14px;
        }

        .hero-title {
            font-size: 3.8rem;
            line-height: 1.2;
            margin-bottom: 25px;
            color: var(--light-cream);
        }

        .hero-title span {
            background: var(--gradient-luxury);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .hero-description {
            font-size: 1.2rem;
            color: rgba(245, 242, 232, 0.8);
            margin-bottom: 50px;
            max-width: 700px;
            line-height: 1.8;
        }

        .hero-buttons {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .btn-luxury {
            background: var(--gradient-luxury);
            color: var(--primary-dark);
            padding: 16px 40px;
            border-radius: var(--radius-pill);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition-luxury);
            border: none;
            cursor: pointer;
            box-shadow: var(--shadow-soft);
            font-size: 16px;
        }

        .btn-luxury:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hard);
        }

        .btn-secondary {
            background: transparent;
            color: var(--primary-gold);
            padding: 16px 40px;
            border-radius: var(--radius-pill);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition-luxury);
            border: 2px solid var(--primary-gold);
        }

        .btn-secondary:hover {
            background: rgba(212, 175, 55, 0.1);
            transform: translateY(-5px);
        }

        /* About Section */
        .section {
            padding: 120px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 80px;
        }

        .section-title h2 {
            font-size: 3.2rem;
            margin-bottom: 20px;
            position: relative;
            display: inline-block;
            color: var(--light-cream);
        }

        .section-title h2::after {
            content: '';
            position: absolute;
            width: 100px;
            height: 3px;
            background: var(--gradient-luxury);
            bottom: -15px;
            left: 50%;
            transform: translateX(-50%);
            border-radius: 2px;
        }

        .section-title p {
            color: rgba(245, 242, 232, 0.8);
            font-size: 1.1rem;
            max-width: 700px;
            margin: 30px auto 0;
            line-height: 1.8;
        }

        .about-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .about-text h3 {
            font-size: 2rem;
            margin-bottom: 25px;
            color: var(--primary-gold);
        }

        .about-text p {
            margin-bottom: 25px;
            color: rgba(245, 242, 232, 0.8);
            line-height: 1.8;
        }

        .vision-mission {
            background: rgba(26, 26, 46, 0.7);
            color: var(--light-cream);
            padding: 70px;
            border-radius: var(--radius-elegant);
            margin-top: 60px;
            border: 1px solid rgba(212, 175, 55, 0.2);
            backdrop-filter: blur(10px);
        }

        .vision-mission h3 {
            color: var(--primary-gold);
            margin-bottom: 40px;
            font-size: 2.2rem;
            text-align: center;
        }

        .vision-mission-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
        }

        .vm-item {
            padding: 40px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: var(--radius-elegant);
            backdrop-filter: blur(5px);
            border: 1px solid rgba(212, 175, 55, 0.1);
            transition: var(--transition-luxury);
        }

        .vm-item:hover {
            border-color: var(--primary-gold);
            transform: translateY(-5px);
        }

        .vm-item h4 {
            color: var(--light-cream);
            font-size: 1.5rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

        .vm-item h4 i {
            margin-right: 15px;
            color: var(--primary-gold);
            font-size: 24px;
        }

        /* Luxury Services */
        .services-luxury {
            background: var(--primary-navy);
            position: relative;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
        }

        .service-card {
            background: rgba(10, 10, 15, 0.7);
            border-radius: var(--radius-elegant);
            padding: 50px 40px;
            box-shadow: var(--shadow-soft);
            transition: var(--transition-luxury);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(212, 175, 55, 0.1);
            backdrop-filter: blur(10px);
        }

        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--gradient-luxury);
            opacity: 0;
            transition: opacity 0.6s ease;
            z-index: -1;
        }

        .service-card:hover::before {
            opacity: 0.05;
        }

        .service-card:hover {
            transform: translateY(-15px);
            border-color: var(--primary-gold);
            box-shadow: var(--shadow-hard);
        }

        .service-icon {
            width: 80px;
            height: 80px;
            background: rgba(212, 175, 55, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 30px;
            color: var(--primary-gold);
            font-size: 32px;
            border: 2px solid rgba(212, 175, 55, 0.3);
        }

        .service-card h3 {
            font-size: 1.6rem;
            margin-bottom: 20px;
            color: var(--light-cream);
        }

        .service-card p {
            color: rgba(245, 242, 232, 0.8);
            margin-bottom: 25px;
            line-height: 1.7;
        }

        .service-features {
            list-style: none;
            margin-top: 25px;
        }

        .service-features li {
            padding: 10px 0;
            color: rgba(245, 242, 232, 0.8);
            position: relative;
            padding-left: 30px;
            line-height: 1.6;
        }

        .service-features li::before {
            content: '✓';
            position: absolute;
            left: 0;
            color: var(--primary-gold);
            font-weight: bold;
            font-size: 18px;
        }

        /* Why Choose Us - Luxury */
        .why-luxury {
            background: var(--gradient-dark);
        }

        .reasons-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 35px;
        }

        .reason-card {
            text-align: center;
            padding: 50px 30px;
            background: rgba(26, 26, 46, 0.7);
            border-radius: var(--radius-elegant);
            transition: var(--transition-luxury);
            border: 1px solid rgba(212, 175, 55, 0.1);
            backdrop-filter: blur(10px);
        }

        .reason-card:hover {
            background: rgba(212, 175, 55, 0.05);
            transform: translateY(-10px);
            border-color: var(--primary-gold);
            box-shadow: var(--shadow-hard);
        }

        .reason-icon {
            width: 70px;
            height: 70px;
            background: var(--gradient-luxury);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            color: var(--primary-dark);
            font-size: 28px;
            transition: var(--transition-luxury);
        }

        .reason-card:hover .reason-icon {
            transform: rotate(360deg) scale(1.1);
        }

        .reason-card h4 {
            font-size: 1.4rem;
            margin-bottom: 15px;
            color: var(--light-cream);
        }

        .reason-card p {
            color: rgba(245, 242, 232, 0.8);
        }

        /* Industries - Luxury */
        .industries-luxury {
            background: var(--primary-navy);
            position: relative;
        }

        .industries-luxury::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at center, rgba(212, 175, 55, 0.05) 0%, transparent 70%);
        }

        .industries-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 35px;
            text-align: center;
            position: relative;
            z-index: 10;
        }

        .industry-item {
            padding: 40px 25px;
            background: rgba(10, 10, 15, 0.7);
            border-radius: var(--radius-elegant);
            backdrop-filter: blur(10px);
            transition: var(--transition-luxury);
            border: 1px solid rgba(212, 175, 55, 0.1);
        }

        .industry-item:hover {
            background: rgba(212, 175, 55, 0.05);
            transform: translateY(-10px);
            border-color: var(--primary-gold);
            box-shadow: var(--shadow-luxury);
        }

        .industry-item i {
            font-size: 48px;
            margin-bottom: 25px;
            color: var(--primary-gold);
            transition: var(--transition-luxury);
        }

        .industry-item:hover i {
            transform: scale(1.2);
        }

        .industry-item h4 {
            font-size: 1.3rem;
            margin-bottom: 10px;
            color: var(--light-cream);
        }

        .industry-item p {
            color: rgba(245, 242, 232, 0.8);
            font-size: 14px;
        }

        /* Future Plans - Luxury */
        .future-plans-luxury {
            background: var(--gradient-dark);
        }

        .plans-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
            gap: 35px;
        }

        .plan-card {
            background: rgba(26, 26, 46, 0.7);
            padding: 50px 35px;
            border-radius: var(--radius-elegant);
            text-align: center;
            box-shadow: var(--shadow-soft);
            transition: var(--transition-luxury);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(212, 175, 55, 0.1);
            backdrop-filter: blur(10px);
        }

        .plan-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: var(--gradient-luxury);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.6s ease;
        }

        .plan-card:hover::before {
            transform: scaleX(1);
        }

        .plan-card:hover {
            transform: translateY(-10px);
            border-color: var(--primary-gold);
            box-shadow: var(--shadow-hard);
        }

        .plan-icon {
            width: 80px;
            height: 80px;
            background: rgba(212, 175, 55, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            color: var(--primary-gold);
            font-size: 32px;
            border: 2px solid rgba(212, 175, 55, 0.3);
            transition: var(--transition-luxury);
        }

        .plan-card:hover .plan-icon {
            background: var(--gradient-luxury);
            color: var(--primary-dark);
            transform: rotateY(180deg);
        }

        .plan-card h3 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            color: var(--light-cream);
        }

        .plan-card p {
            color: rgba(245, 242, 232, 0.8);
            line-height: 1.7;
        }

        /* Contact - Luxury */
        .contact-luxury {
            background: var(--primary-navy);
        }

        .contact-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: start;
        }

        .contact-info h3 {
            font-size: 2.2rem;
            margin-bottom: 25px;
            color: var(--primary-gold);
        }

        .contact-details {
            margin-top: 50px;
        }

        .contact-detail {
            display: flex;
            align-items: flex-start;
            margin-bottom: 35px;
        }

        .contact-icon {
            width: 60px;
            height: 60px;
            background: rgba(212, 175, 55, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 25px;
            color: var(--primary-gold);
            font-size: 24px;
            flex-shrink: 0;
            border: 2px solid rgba(212, 175, 55, 0.3);
            transition: var(--transition-luxury);
        }

        .contact-detail:hover .contact-icon {
            background: var(--gradient-luxury);
            color: var(--primary-dark);
            transform: rotateY(180deg);
        }

        .contact-text h4 {
            font-size: 1.3rem;
            margin-bottom: 8px;
            color: var(--light-cream);
        }

        .contact-text a {
            color: var(--primary-gold);
            text-decoration: none;
            transition: var(--transition-luxury);
            display: block;
            margin-bottom: 5px;
        }

        .contact-text a:hover {
            color: var(--light-cream);
            padding-left: 5px;
        }

        .contact-form {
            background: rgba(10, 10, 15, 0.7);
            padding: 50px;
            border-radius: var(--radius-elegant);
            box-shadow: var(--shadow-hard);
            border: 1px solid rgba(212, 175, 55, 0.2);
            backdrop-filter: blur(10px);
        }

        .form-group {
            margin-bottom: 30px;
        }

        .form-group label {
            display: block;
            margin-bottom: 10px;
            font-weight: 600;
            color: var(--primary-gold);
            font-size: 15px;
            letter-spacing: 0.5px;
        }

        .form-control {
            width: 100%;
            padding: 18px 20px;
            background: rgba(245, 242, 232, 0.05);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 10px;
            color: var(--light-cream);
            font-family: 'Inter', sans-serif;
            font-size: 16px;
            transition: var(--transition-luxury);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-gold);
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
            background: rgba(245, 242, 232, 0.08);
        }

        textarea.form-control {
            min-height: 160px;
            resize: vertical;
        }

        /* Luxury Footer */
        .luxury-footer {
            background: var(--primary-dark);
            color: var(--light-cream);
            padding: 100px 0 40px;
            border-top: 1px solid rgba(212, 175, 55, 0.2);
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 60px;
            margin-bottom: 70px;
        }

        .footer-logo {
            font-size: 32px;
            font-weight: 800;
            background: var(--gradient-luxury);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 20px;
            display: inline-block;
        }

        .footer-about p {
            color: rgba(245, 242, 232, 0.8);
            margin-bottom: 30px;
            line-height: 1.8;
        }

        .social-links {
            display: flex;
            gap: 15px;
        }

        .social-link {
            width: 45px;
            height: 45px;
            background: rgba(212, 175, 55, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-gold);
            text-decoration: none;
            transition: var(--transition-luxury);
            border: 1px solid rgba(212, 175, 55, 0.3);
        }

